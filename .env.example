POSTGRES_DB=sgi_comando
POSTGRES_USER=sgi
POSTGRES_PASSWORD=sgi_uat_2026
MINIO_ROOT_USER=sgiadmin
MINIO_ROOT_PASSWORD=sgi_minio_uat_2026

# Generic interconnection module (SITC-NOM-001 v3.0)
# Bootstrap only: CORE resolver endpoint. All other partner bindings are resolved by CORE.
SGI_INTERCONNECTIONS_CORE_RESOLVER_URL=
SGI_INTERCONNECTIONS_ENVIRONMENT=UAT
SGI_INTERCONNECTIONS_CORE_TIMEOUT_MS=2500
SGI_INTERCONNECTIONS_CACHE_TTL_SECONDS=300
SGI_INTERCONNECTIONS_ALLOW_STALE_SECONDS=3600
SGI_INTERCONNECTIONS_CIRCUIT_FAILURE_THRESHOLD=5
SGI_INTERCONNECTIONS_CIRCUIT_OPEN_SECONDS=30
# Token compartido del endpoint inbound SIC:RRHH -> SGI:Comando. Definir fuera del repositorio.
SGI_RRHH_INBOUND_TOKEN=
# Mantener false con DHO actual; activar solo cuando la fuente entregue canonicalEmployeeId UUID.
SGI_RRHH_USE_CANONICAL_EMPLOYEE_ID=false
# Runtime secrets referenced by credentialRef are exposed as SGI_CREDENTIAL_<NORMALIZED_REF>.
# Never store effective secrets in .sitcpack.
SGI_SIC_COM_INBOUND_CREDENTIAL_REF=SIC_COM__SGI_COM__00001__V0001
SGI_CREDENTIAL_SIC_COM__SGI_COM__00001__V0001=
