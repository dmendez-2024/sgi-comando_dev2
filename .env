# VISINT real (se usa con SGI_VISINT_MODE=HTTP). No se versiona.
# Respaldo: se usa si CORE no resuelve la Interconexión de VISINT.
SGI_VISINT_URL=http://181.39.84.138:8010/v1/evidence/validate
SGI_VISINT_TOKEN=8398231db47f81a5c8d8f131171aeb6cf8cff6040aab1e7a674d49d16a967f94
# Umbral de coincidencia que SGI envía a VISINT (0 a 1; obligatorio en VISINT desde 2026-10-05). PASS si la mejor coincidencia lo alcanza.
SGI_VISINT_MATCH_THRESHOLD=0.8

# CORE resuelve la URL de VISINT (Interconexión SGI_COM_VISINT_0001_v002). Si CORE falla se usa SGI_VISINT_URL.
# Modo LOCAL (CORE en la red local):
# SGI_INTERCONNECTIONS_CORE_RESOLVER_URL=http://192.168.20.138:5173
# SGI_INTERCONNECTIONS_ENVIRONMENT=LOCAL
