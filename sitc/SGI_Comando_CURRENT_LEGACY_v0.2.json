  "packageType": "cumulative-final",
  "system": "SGI: Comando",
  "asOf": "2026-09-20",
  "architecture": {
    "style": "modular-monolith",
    "frontend": "React 19.2 + TypeScript 6",
    "backend": "Java 25 LTS + Quarkus",
    "database": "PostgreSQL 17",
