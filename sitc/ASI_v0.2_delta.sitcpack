{
  "format": "cajamarca.sitcpack",
  "formatVersion": "0.2",
  "packageType": "vertical-delta",
  "system": "SGI: Comando",
  "vertical": {
    "code": "ASI",
    "name": "Asignaciones",
    "version": "0.2",
    "status": "UAT_CANDIDATE",
    "legacyModule": "SGI-06"
  },
  "base": {
    "TER": "1.0 FROZEN",
    "COM": "1.0 FROZEN",
    "ASI": "0.1"
  },
  "scope": [
    "person card click-vs-drag interaction",
    "assignment card person-link interaction",
    "drag-and-drop regression fix"
  ],
  "connections": [
    {
      "from": "COM",
      "to": "ASI",
      "data": [
        "authorized Companies",
        "Company-Region links"
      ],
      "sor": "COM"
    },
    {
      "from": "TER",
      "to": "ASI",
      "data": [
        "Zone/Region operational scopes"
      ],
      "sor": "TER"
    },
    {
      "from": "SIC: COM",
      "to": "ASI",
      "data": [
        "Client",
        "Points",
        "Posts",
        "Shifts",
        "TIER"
      ],
      "sor": "SIC: COM"
    },
    {
      "from": "SIC: RRHH",
      "to": "ASI",
      "data": [
        "Company personnel",
        "employment status",
        "skills",
        "vacation",
        "medical leave",
        "unavailability"
      ],
      "sor": "SIC: RRHH"
    },
    {
      "from": "SMC",
      "to": "ASI",
      "data": [
        "ID - Índice de Desempeño"
      ],
      "sor": "SMC"
    }
  ],
  "rules": [
    "name click opens employee profile",
    "card click outside name selects/evaluates employee",
    "card press+move outside name starts drag-and-drop for editable roles",
    "assigned-card photo does not open employee profile; assigned-card name does",
    "IC control keeps compatibility-detail action",
    "TER 1.0 and COM 1.0 remain frozen"
  ],
  "documentation": "docs/verticals/ASI/ASI_MASTER.md"
}