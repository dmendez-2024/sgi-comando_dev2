      "component": "Configuración > Patrullas",
      "item": "Rebuild protocol/patrol header hierarchy, co-locate version actions, add explicit immutable/read-only banner and materially increase typography/spacing."
    },
    {
      "type": "decision-preserved",
      "component": "Versioning",
