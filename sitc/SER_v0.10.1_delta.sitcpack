  "changes": [
    {
      "type": "workflow",
      "component": "Bitacora / Patrullas / Consignas Protocols",
      "item": "Standardize protocol states to BORRADOR, INACTIVO and ACTIVO; publish transitions draft to inactive; activate/deactivate is explicit."
    },
    {
      "type": "guardrail",
      "component": "Bitacora",
      "item": "Maximum 10 Acreditaciones per Protocol, enforced in frontend and backend."
    },
    {
      "type": "ux",
      "component": "Patrullas",
      "item": "Align layout with Bitacora using Puestos del Punto, Protocolos del Puesto and a large protocol detail panel containing Patrullas del protocolo and patrol configuration."
    },
    {
      "type": "migration",
      "component": "Flyway V21",
      "item": "Map legacy protocol statuses and create updated status constraints/indexes while preserving child Consignment operational status compatibility."
    },
    {
      "type": "runtime",
      "component": "UAT scripts",
      "item": "Preserve Docker Compose stack: backend readiness at port 8080; frontend opened at port 5173."
    }
  ],
